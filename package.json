{
  "name": "hvik-app",
  "productName": "HviK",
  "version": "0.26.0",
  "description": "HviK Community – Desktop-App",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.5.1",
    "adm-zip": "^0.6.1",
    "electron-updater": "^6.8.9"
  },
  "author": "HviK Community",
  "homepage": "https://hvik.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bukaas/HviK-App.git"
  },
  "build": {
    "appId": "org.hvik.app",
    "productName": "HviK",
    "copyright": "HviK Community",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "HviK-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "HviK Community App",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "uninstallDisplayName": "HviK Community App",
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Bukaas",
        "repo": "HviK-App",
        "releaseType": "release"
      }
    ]
  }
}
